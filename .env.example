# --- Supabase (obbligatorio) -------------------------------------------
# Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# --- Email (facoltativo) -----------------------------------------------
# Senza queste variabili l'app funziona lo stesso: semplicemente non
# invia email. Chiave da resend.com (piano gratuito: 100 email/giorno).
RESEND_API_KEY=re_xxxxxxxxxxxx

# Dove arrivano gli avvisi di nuova richiesta. Piu' indirizzi separati
# da virgola.
NOTIFY_EMAIL=coach@tuapalestra.it

# Mittente. DEVE essere un dominio verificato su Resend: finche' non ne
# hai verificato uno, lascia esattamente onboarding@resend.dev, altrimenti
# Resend rifiuta l'invio e non parte nessuna email.
NOTIFY_FROM=Prenotazioni <onboarding@resend.dev>
