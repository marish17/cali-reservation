# --- Supabase (obbligatorio) -------------------------------------------
# Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# --- Notifiche al coach (facoltativo) ----------------------------------
# Senza queste variabili l'app funziona lo stesso: semplicemente non
# invia email. Chiave da resend.com (piano gratuito: 100 email/giorno).
RESEND_API_KEY=re_xxxxxxxxxxxx
# Destinatario delle notifiche. Più indirizzi separati da virgola.
NOTIFY_EMAIL=coach@tuapalestra.it
# Mittente. Per partire subito va bene onboarding@resend.dev;
# per usare il tuo dominio va prima verificato su Resend.
NOTIFY_FROM=Prenotazioni <onboarding@resend.dev>
